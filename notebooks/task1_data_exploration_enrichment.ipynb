 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task 1: Data Exploration and Enrichment\n",
    "\n",
    "Load and understand the unified schema, then enrich with external data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime\n",
    "import os\n",
    "\n",
    "# Load datasets (adjust paths if running from different location)\n",
    "df = pd.read_csv('../data/ethiopia_fi_unified_data.csv')\n",
    "ref_codes = pd.read_csv('../data/reference_codes.csv')\n",
    "\n",
    "print(\"Shape:\", df.shape)\n",
    "print(\"\\nColumns:\", df.columns.tolist())\n",
    "print(\"\\nFirst 5 rows:\")\n",
    "print(df.head())\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)\n",
    "print(\"\\nUnique record types:\")\n",
    "print(df['record_type'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Counts by record_type\n",
    "print(df['record_type'].value_counts())\n",
    "\n",
    "# Convert dates\n",
    "df['observation_date'] = pd.to_datetime(df['observation_date'], errors='coerce')\n",
    "obs = df[df['record_type'] == 'observation']\n",
    "print(\"Observation date range:\", obs['observation_date'].min(), \"to\", obs['observation_date'].max())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "indicators = df[df['record_type'] == 'observation']['indicator_code'].unique()\n",
    "for ind in indicators:\n",
    "    sub = df[(df['record_type'] == 'observation') & (df['indicator_code'] == ind)]\n",
    "    years = sub['observation_date'].dt.year.unique()\n",
    "    print(f\"{ind}: {len(sub)} records, years {sorted(years)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "events = df[df['record_type'] == 'event']\n",
    "print(\"Events:\")\n",
    "print(events[['observation_date', 'indicator', 'category']].sort_values('observation_date'))\n",
    "\n",
    "impact_links = df[df['record_type'] == 'impact_link']\n",
    "print(\"\\nImpact links:\")\n",
    "print(impact_links[['parent_id', 'pillar', 'related_indicator', 'impact_direction', 'impact_magnitude', 'lag_months']])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Enrich the Dataset\n",
    "\n",
    "Add new observations, events, and impact links."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "new_obs = pd.DataFrame([{\n",
    "    'record_type': 'observation',\n",
    "    'pillar': 'Infrastructure',\n",
    "    'indicator': 'Mobile phone penetration (per 100 adults)',\n",
    "    'indicator_code': 'INF_MOBILE_PEN',\n",
    "    'value_numeric': 65.0,\n",
    "    'observation_date': '2025-01-01',\n",
    "    'source_name': 'GSMA State of the Industry Report 2025',\n",
    "    'source_url': 'https://www.gsma.com/sotir/2025',\n",
    "    'confidence': 'medium',\n",
    "    'parent_id': np.nan,\n",
    "    'category': np.nan,\n",
    "    'impact_direction': np.nan,\n",
    "    'impact_magnitude': np.nan,\n",
    "    'lag_months': np.nan,\n",
    "    'evidence_basis': np.nan,\n",
    "    'original_text': 'Mobile penetration reached 65 per 100 adults in Ethiopia in 2025.',\n",
    "    'collected_by': 'Your Name',\n",
    "    'collection_date': datetime.today().strftime('%Y-%m-%d'),\n",
    "    'notes': 'Useful as an enabler for digital payments.'\n",
"}])\n",
    "df = pd.concat([df, new_obs], ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "new_event = pd.DataFrame([{\n",
    "    'record_type': 'event',\n",
    "    'pillar': np.nan,\n",
    "    'indicator': 'NBE announces interoperability mandate for all PSPs',\n",
    "    'indicator_code': 'EVT_INTEROP_MANDATE',\n",
    "    'value_numeric': np.nan,\n",
    "    'observation_date': '2025-06-01',\n",
    "    'source_name': 'National Bank of Ethiopia press release',\n",
    "    'source_url': 'https://nbe.gov.et/interoperability',\n",
    "    'confidence': 'high',\n",
    "    'parent_id': np.nan,\n",
    "    'category': 'policy',\n",
    "    'impact_direction': np.nan,\n",
    "    'impact_magnitude': np.nan,\n",
    "    'lag_months': np.nan,\n",
    "    'evidence_basis': np.nan,\n",
    "    'original_text': 'All payment service providers must enable interoperability by Q4 2025.',\n",
    "    'collected_by': 'Your Name',\n",
    "    'collection_date': datetime.today().strftime('%Y-%m-%d'),\n",
    "    'notes': 'Could boost digital payments by reducing friction.'\n",
    "}])\n",
    "df = pd.concat([df, new_event], ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "new_impact = pd.DataFrame([{\n",
    "    'record_type': 'impact_link',\n",
    "    'pillar': 'Usage',\n",
    "    'indicator': 'Digital payment adoption rate',\n",
    "    'indicator_code': 'USG_DIGITAL_PAYMENT',\n",
    "    'value_numeric': np.nan,\n",
    "    'observation_date': np.nan,\n",
    "    'source_name': 'Expert estimate based on Kenya interoperability experience',\n",
    "    'source_url': 'https://www.cgap.org/...',\n",
    "    'confidence': 'medium',\n",
    "    'parent_id': len(df) - 1,  # index of the event we just added (last row)\n",
    "    'category': np.nan,\n",
    "    'impact_direction': 'positive',\n",
    "    'impact_magnitude': 2.5,\n",
    "    'lag_months': 12,\n",
    "    'evidence_basis': 'Similar policies in Kenya led to +2-3 pp increase in digital payments within a year.',\n",
    "    'original_text': np.nan,\n",
    "    'collected_by': 'Your Name',\n",
    "    'collection_date': datetime.today().strftime('%Y-%m-%d'),\n",
    "    'notes': 'Assumes gradual effect over 12 months.'\n",
    "}])\n",
    "df = pd.concat([df, new_impact], ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ensure dates are string for CSV\n",
    "df['observation_date'] = df['observation_date'].astype(str)\n",
    "os.makedirs('../data/enriched', exist_ok=True)\n",
    "df.to_csv('../data/enriched/ethiopia_fi_unified_data_enriched.csv', index=False)\n",
    "print(\"Enriched dataset saved to ../data/enriched/ethiopia_fi_unified_data_enriched.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Enrichment Log\n",
    "\n",
    "Ensure data/enriched/data_enrichment_log.md is created with the details of added records.\n",
    "\n",
    "Key additions:\n",
    "- INF_MOBILE_PEN (2025)\n",
    "- EVT_INTEROP_MANDATE (2025-06-01)\n",
    "- Impact link to USG_DIGITAL_PAYMENT (+2.5 pp, lag 12 months)"
   ]
  }
 ],
